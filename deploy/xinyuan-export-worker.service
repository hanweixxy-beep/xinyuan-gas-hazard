[Unit]
Description=Xinyuan gas inspection export worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/xinyuan-gas/backend
ExecStart=/usr/bin/php -d memory_limit=512M /var/www/xinyuan-gas/backend/bin/export-worker.php
Restart=always
RestartSec=5
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xinyuan-gas-exports
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
