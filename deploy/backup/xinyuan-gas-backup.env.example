PROJECT_ROOT=/var/www/xinyuan-gas
UPLOAD_ROOT=/var/www/xinyuan-gas/backend/storage/uploads
BACKUP_ROOT=/var/backups/xinyuan-gas
DB_NAME=xinyuan_gas

# Keep the most recent 14 daily snapshots and 8 weekly full archives.
DAILY_KEEP_COUNT=14
WEEKLY_KEEP_COUNT=8
MIN_FREE_MB=2048

LOG_FILE=/var/log/xinyuan-gas-backup.log
NGINX_SITE_CONFIG=/etc/nginx/sites-available/xinyuan-gas.conf

# Configure only after an encrypted rclone crypt remote has been created.
# Example: xinyuan-crypt:xinyuan-gas-production
RCLONE_CONFIG=/etc/xinyuan-gas/rclone.conf
OFFSITE_REMOTE=
OFFSITE_ENCRYPTED=false
