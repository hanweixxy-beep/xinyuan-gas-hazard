# Copy to backend/.env; replace both absolute paths and the local-only password.
# Never copy production credentials into this template.
APP_ENV=local
APP_DEBUG=false
APP_BASE_URL=http://127.0.0.1:8080
SESSION_DAYS=7
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xinyuan_test_dev
DB_USERNAME=xinyuan_dev
DB_PASSWORD=replace-with-local-password
UPLOAD_ROOT=/ABSOLUTE/LOCAL/PATH/xinyuan/backend/storage/uploads
EXPORT_ROOT=/ABSOLUTE/LOCAL/PATH/xinyuan/backend/storage/exports
TENCENT_MAP_WEB_SERVICE_KEY=
